<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title><%= folder.title %></title>
  </head>
  <body>
    <% if (currentUser) { %>
      <%-include("./partials/header")%>
      <button id="upload-to-folder-btn" popovertarget="upload-to-folder">Upload</button>
      <div popover id="upload-to-folder">
        <form action="/file/new/<%=folder.id%>" method="post" enctype="multipart/form-data">
          <legend>Upload File</legend>
          <div class="form-group">
            <label for="title">Title</label>
            <input type="text" name="title" id="title">
          </div>
          <div class="form-group">
            <label for="file">Choose a File: </label>
            <input type="file" id="file" name="file" />  
          </div>
          <button type="submit">Upload</button>
        </form>
      </div>
      <div>
        <h2><%= folder.title %></h2>
        <button popovertarget="edit-folder">Edit Folder</button> 
        <div popover id="edit-folder" class="form-popover">
          <form action="/folders/<%=folder.id%>/update" method="post">
            <div class="form-group">
              <label for="title">Rename: </label>
              <input
                type="text"
                name="title"
                id="title"
                minlength="1"
                maxlength="10"
                placeholder="Folder 1 New"
                required
              />
            </div>
            <button type="submit">Submit</button>
          </form>
          <form action="/folders/<%= folder.id%>/delete" method="post">
            <button type="submit">Delete Folder</button>
          </form>
        </div>
      </div>
      <% if(Array.isArray(folder.File)) {%>
        <ul class="file-list">
          <% folder.File.forEach(file => {%>
            <li class="file">
              <img src="<%= file.fileUrl %>" alt="img" />
              <a href="/file/<%= file.id %>"><%= file.name %></a>
            </li>
          <%})%>
        </ul>
      <%}%>
    <%} else {%>
      <%-include('./partials/login')%>
    <%}%>
  </body>
</html>
